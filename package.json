{
  "name": "error-driven-typescript-lab",
  "version": "0.1.0",
  "private": true,
  "description": "失敗するテストからTypeScriptのエラーを学ぶ教材",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run clean && npm run build && node --test dist/test/**/*.test.js",
    "verify": "npm run typecheck && npm test && ./scripts/verify-course.sh"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
